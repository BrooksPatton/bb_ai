let THEME = {
	error: {
		color: "red"
	},
	normal: {
		color: "white"
	}
}

if state.keep_for > 0
	container [max_height: 3]
		position [placement: "absolute", top: attributes.top, left: 0]
			hstack
				spacer
				border [foreground: THEME[state.theme].color]
					padding [padding: 1]
						text [foreground: THEME[state.theme].color] state.message
				spacer
