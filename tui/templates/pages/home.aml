hstack
	vstack [width: attributes.width - 40]
		container [height: attributes.height - 7]
			for message in state.messages
				hstack
					if state.messages_from[loop] == "user"
						spacer
						border [border_style: "rounded"]
							text message
					else
						text message
		spacer
		@input (
			OnSubmit -> OnSubmit,
			OnUpdate -> OnUpdate,
			) [
				cursor: true
			]
	border [sides: "left", width: 40]
		vstack
			border [sides: "bottom"]
				hstack
					spacer
					text "Session"
					spacer
			text "Tokens: 0"
			text "Cost: $0.00"
			hstack
				text "model: "
			if attributes.model_name == ""
				text "-----"
			else
				text attributes.model_name
			@connection_side [openrouter_key: state.openrouter_key]
			padding [top: 1]
				border [sides: "bottom"]
					hstack
						spacer
						text "Log"
						spacer
			text "Query: My first..."
			padding [top: 1]
				text "Response: Ai response..."
			spacer
